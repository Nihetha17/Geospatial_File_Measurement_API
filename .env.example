# Copy this file to ".env" to override defaults. All values are optional.
# Relative paths are resolved from the project root.

# SQLite database file (created automatically)
GEO_DATABASE_PATH=data/geospatial.db

# Maximum size of an uploaded file, in megabytes
GEO_MAX_UPLOAD_MB=20

# Maximum number of features accepted per file
GEO_MAX_FEATURES=10000

# ZIP hardening limits
GEO_MAX_ZIP_ENTRIES=200
GEO_MAX_ZIP_UNCOMPRESSED_MB=200
GEO_MAX_ZIP_COMPRESSION_RATIO=200
